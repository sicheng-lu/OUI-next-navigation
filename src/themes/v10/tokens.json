{
  "name": "v10 · Blueprint (D3)",
  "version": "10.0.0",
  "description": "Drafting/blueprint visual language for OpenSearch. Navy paper, mono labels, square corners, inline-SVG instrumentation. Ships with light and dark modes.",
  "modes": {
    "dark": {
      "bg":         "#0d3057",
      "bgDeep":     "#0a2545",
      "panel":      "rgba(10, 37, 69, 0.55)",
      "panelSolid": "#103e6e",
      "ink":        "#cfe4f7",
      "inkBright":  "#ffffff",
      "inkDim":     "rgba(207, 228, 247, 0.62)",
      "inkFade":    "rgba(207, 228, 247, 0.34)",
      "inkGhost":   "rgba(207, 228, 247, 0.16)",
      "cyan":       "#5dd9ff",
      "cyanDim":    "rgba(93, 217, 255, 0.45)",
      "cyanSoft":   "rgba(93, 217, 255, 0.10)",
      "amber":      "#ffb86b",
      "amberDim":   "rgba(255, 184, 107, 0.45)",
      "amberSoft":  "rgba(255, 184, 107, 0.12)",
      "green":      "#7be0a8",
      "greenDim":   "rgba(123, 224, 168, 0.45)",
      "greenSoft":  "rgba(123, 224, 168, 0.10)",
      "red":        "#ff7a7a",
      "redDim":     "rgba(255, 122, 122, 0.45)",
      "redSoft":    "rgba(255, 122, 122, 0.10)",
      "gridFine":   "rgba(207, 228, 247, 0.05)",
      "gridMajor":  "rgba(207, 228, 247, 0.10)",
      "inputBg":    "rgba(10, 37, 69, 0.45)",
      "codeBg":     "rgba(10, 37, 69, 0.70)",
      "scrollThumb":      "rgba(207, 228, 247, 0.22)",
      "scrollThumbHover": "rgba(207, 228, 247, 0.38)"
    },
    "light": {
      "bg":         "#eef2f7",
      "bgDeep":     "#dde4ee",
      "panel":      "rgba(255, 255, 255, 0.85)",
      "panelSolid": "#ffffff",
      "ink":        "#0d3057",
      "inkBright":  "#06203f",
      "inkDim":     "rgba(13, 48, 87, 0.62)",
      "inkFade":    "rgba(13, 48, 87, 0.32)",
      "inkGhost":   "rgba(13, 48, 87, 0.14)",
      "cyan":       "#1f6cb5",
      "cyanDim":    "rgba(31, 108, 181, 0.40)",
      "cyanSoft":   "rgba(31, 108, 181, 0.08)",
      "amber":      "#c47a1f",
      "amberDim":   "rgba(196, 122, 31, 0.45)",
      "amberSoft":  "rgba(196, 122, 31, 0.10)",
      "green":      "#2e8b6f",
      "greenDim":   "rgba(46, 139, 111, 0.45)",
      "greenSoft":  "rgba(46, 139, 111, 0.08)",
      "red":        "#c53961",
      "redDim":     "rgba(197, 57, 97, 0.45)",
      "redSoft":    "rgba(197, 57, 97, 0.08)",
      "gridFine":   "rgba(13, 48, 87, 0.05)",
      "gridMajor":  "rgba(13, 48, 87, 0.10)",
      "inputBg":    "rgba(255, 255, 255, 0.70)",
      "codeBg":     "rgba(13, 48, 87, 0.05)",
      "scrollThumb":      "rgba(13, 48, 87, 0.14)",
      "scrollThumbHover": "rgba(13, 48, 87, 0.24)"
    }
  },
  "typography": {
    "families": {
      "sans": "'Outfit', system-ui, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "licenses": {
      "Outfit": "SIL Open Font License 1.1",
      "IBM Plex Mono": "SIL Open Font License 1.1"
    },
    "weights": [400, 500, 600, 700],
    "roles": {
      "pageTitle":      { "family": "sans", "weight": 600, "size": 38, "letterSpacing": -1,    "lineHeight": 1.05 },
      "screenTitle":    { "family": "sans", "weight": 600, "size": 32, "letterSpacing": -0.8,  "lineHeight": 1.1  },
      "panelTitle":     { "family": "sans", "weight": 600, "size": 22, "letterSpacing": -0.4,  "lineHeight": 1.2  },
      "cardTitle":      { "family": "sans", "weight": 600, "size": 17, "letterSpacing": -0.2,  "lineHeight": 1.3  },
      "subTitle":       { "family": "sans", "weight": 600, "size": 16, "letterSpacing": -0.2,  "lineHeight": 1.3  },
      "body":           { "family": "sans", "weight": 500, "size": 14.5, "letterSpacing": -0.1, "lineHeight": 1.5 },
      "description":    { "family": "sans", "weight": 400, "size": 15,  "letterSpacing": 0,    "lineHeight": 1.5  },
      "small":          { "family": "sans", "weight": 400, "size": 13,  "letterSpacing": -0.05, "lineHeight": 1.5 },
      "label":          { "family": "mono", "weight": 700, "size": 10.5, "letterSpacing": 1.8,  "uppercase": true },
      "tinyLabel":      { "family": "mono", "weight": 600, "size": 9.5, "letterSpacing": 1.4,  "uppercase": true },
      "metric":         { "family": "mono", "weight": 700, "size": 11.5, "letterSpacing": 0.3 },
      "metricLarge":    { "family": "mono", "weight": 700, "size": 28,  "letterSpacing": -0.5 },
      "code":           { "family": "mono", "weight": 400, "size": 11.5, "lineHeight": 1.55 },
      "filename":       { "family": "mono", "weight": 700, "size": 12.5, "letterSpacing": 0.3 },
      "statusPill":     { "family": "mono", "weight": 700, "size": 9,   "letterSpacing": 1.4,  "uppercase": true }
    }
  },
  "spacing": {
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 10,
    "6": 12, "7": 14, "8": 16, "9": 18, "10": 20, "11": 22,
    "12": 24, "14": 28, "16": 32, "18": 36, "20": 40, "24": 48, "28": 56
  },
  "borders": {
    "hairline":   { "width": 1, "useFor": "panels, dividers, default borders" },
    "accent":     { "width": 2, "useFor": "card left-accent stripe" },
    "ring":       { "width": 1.4, "useFor": "avatar rings" },
    "svgThick":   { "width": 1.2, "useFor": "primary SVG strokes" },
    "svgMedium":  { "width": 0.9, "useFor": "secondary SVG strokes (cube edges, gauges)" },
    "svgThin":    { "width": 0.6, "useFor": "grid lines, baselines, tertiary" },
    "radius":     0
  },
  "shadows": {
    "none": "0 0 0 transparent",
    "avatarRing": "inset 0 0 0 2-3px <bg>, inset 0 0 0 3-4px <accentDim>"
  },
  "grid": {
    "fineStep":  16,
    "majorStep": 80,
    "applyAs":   "background-image: 4 layered linear-gradients (right fine, bottom fine, right major, bottom major)"
  },
  "iconStrokeWidth": {
    "small":  1.3,
    "medium": 1.4,
    "large":  1.6
  },
  "motion": {
    "themeTransition": "200ms ease",
    "pillCrossfade":   "200ms ease",
    "default":         "150ms ease-out"
  }
}
